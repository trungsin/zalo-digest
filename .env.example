# Tên hiển thị trong log và email cảnh báo (mặc định là tên thư mục)
# USER_NAME=An

# ID các nhóm cần theo dõi, cách nhau dấu phẩy. Lấy bằng: USER_DIR=users/<tên> npm run groups
TRACKED_GROUP_IDS=

# --- Model ---
# gemini (mặc định, có free tier) hoặc claude (trả phí, ~0,6 USD/tháng với Haiku)
LLM_PROVIDER=gemini
# Lưu ý: ở free tier, Google có thể dùng nội dung gửi lên (tin nhắn group) để cải thiện sản phẩm.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=                     # mặc định: gemini-flash-latest / claude-haiku-4-5

# --- Cá nhân hóa ---
# Bạn là ai, quan tâm điều gì. Báo cáo sẽ ưu tiên theo đây.
USER_PROFILE="Tôi là trưởng phòng sales Hà Nội. Ưu tiên số liệu doanh số, khách hàng lớn và việc team chưa hoàn thành."
# short (mặc định) hoặc detailed
# REPORT_STYLE=short
# REPORT_CRON=0 8 * * *          # giờ gửi báo cáo (mặc định 8h sáng)
# TZ_REPORT=Asia/Ho_Chi_Minh

# --- Số liệu ---
# Cách viết tắt riêng của các nhóm, giúp model hiểu đúng
# METRIC_HINTS="DS = doanh số; KH = khách hàng mới; TL = tỷ lệ chốt; số tiền không ghi đơn vị là triệu đồng"

# --- Việc & nhắc deadline ---
# EXTRACT_CRON=5 7-21/2 * * *    # lịch quét tin để trích việc + số liệu (mỗi lần quét = 1 request model nếu có tin mới)
# REMIND_BEFORE_MIN=120          # nhắc trước hạn bao nhiêu phút
# MAX_REMINDERS_PER_DAY=5        # tối đa số tin nhắc mỗi ngày
# QUIET_HOURS=22-7               # không nhắc trong khoảng giờ này

# --- Cảnh báo qua email khi mất phiên Zalo (khuyên dùng) ---
# SMTP_URL=smtps://ban%40gmail.com:app-password@smtp.gmail.com:465
# ALERT_EMAIL=ban@gmail.com
