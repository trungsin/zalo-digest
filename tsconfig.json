{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // zca-js's root index.d.ts does `export * from "./dist"`, which NodeNext can't resolve.
    "paths": { "zca-js": ["./node_modules/zca-js/dist/index.d.ts"] }
  },
  "include": ["src"]
}
